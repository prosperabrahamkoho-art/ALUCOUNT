# ── ALUCOUNT — Template Variables d'environnement Supabase ──────────────────
# Copiez ce fichier en .env et remplacez les valeurs par vos credentials
# Trouvez vos clés dans : Supabase Dashboard → Settings → API
#
# cp .env.example .env

VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre_anon_key_publique_ici

# ─────────────────────────────────────────────────────────────────────────────
# ✅  CE fichier PEUT être commité dans Git (pas de secrets réels)
# ⚠️  Le fichier .env (avec les vraies clés) est dans .gitignore
# ─────────────────────────────────────────────────────────────────────────────
